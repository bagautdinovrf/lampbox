{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mediabox:active-publication:v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "mediabox.active"
    },
    "schemaVersion": {
      "const": 1
    },
    "scheduleId": {
      "$ref": "#/$defs/id"
    },
    "stationId": {
      "$ref": "#/$defs/id"
    },
    "publicationId": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "$ref": "#/$defs/revision"
    },
    "snapshotPath": {
      "type": "string",
      "pattern": "^snapshots/[0-9a-f-]{36}\\.json$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "scheduleId",
    "stationId",
    "publicationId",
    "revision",
    "snapshotPath",
    "sha256"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    }
  }
}
